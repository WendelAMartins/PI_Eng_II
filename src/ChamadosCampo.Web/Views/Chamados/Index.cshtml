@model List<Chamado>
@{ ViewData["Title"] = "Meus chamados"; var nome = (string?)ViewBag.Busca; }

<div class="pagina-topo">
    <div>
        <h1>Meus chamados</h1>
        <p>Acompanhe o andamento de tudo que você solicitou.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">+ Abrir chamado</a>
</div>

<form method="get" class="cartao mb-3">
    <label for="busca" class="form-label">Seu nome ou o número da OS</label>
    <div class="d-flex gap-2">
        <input id="busca" name="busca" class="form-control" value="@nome" placeholder="Ex.: Maria Silva, ou OS 4" required />
        <button class="btn btn-primary">Consultar</button>
    </div>
</form>

@if (string.IsNullOrWhiteSpace(nome))
{
    <div class="cartao vazio"><span class="icone">🔎</span>Informe seu nome (ou o número da OS) para ver seus chamados. A OS só existe depois que a chefia aceita o chamado.</div>
}
else if (!Model.Any())
{
    <div class="cartao vazio"><span class="icone">📭</span>Nenhum chamado encontrado para “@nome”.</div>
}
else
{
    <div class="lista-chamados">
    @foreach (var c in Model)
    {
        <a class="cartao item-chamado" asp-action="Details" asp-route-id="@c.Id">
            <div>
                <strong><span class="os-numero">@c.Titulo()</span> · @c.Tipo.Rotulo()</strong>
                <span class="meta">@c.Endereco@(c.DataProgramada is DateOnly d ? $" · programado para {d:dd/MM/yyyy}" : "")</span>
            </div>
            <partial name="_Selo" model="c.Status" />
        </a>
    }
    </div>
}
