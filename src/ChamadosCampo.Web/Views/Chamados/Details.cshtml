@model Chamado
@{
    ViewData["Title"] = Model.Titulo();
    var etapas = new[] { StatusChamado.Solicitado, StatusChamado.Aceito, StatusChamado.Programado, StatusChamado.EmAndamento, StatusChamado.Encerrado };
    int atual = Model.Status == StatusChamado.Recusado ? -1 : Array.IndexOf(etapas, Model.Status);
}

<div class="pagina-topo">
    <div>
        <h1><span class="os-numero">@Model.Titulo()</span> · @Model.Tipo.Rotulo()</h1>
        <p>Aberto em @Model.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm") por @Model.Solicitante</p>
    </div>
    <partial name="_Selo" model="Model.Status" />
</div>

@if (Model.NumeroOs is null && Model.Status == StatusChamado.Solicitado)
{
    <div class="alert alert-info">Seu chamado está <strong>em análise</strong>. O número da OS é gerado quando a chefia aceitar o pedido; até lá ele aparece como “Chamado #@Model.Id”.</div>
}

@if (Model.Status != StatusChamado.Recusado)
{
    <ol class="etapas cartao" aria-label="Progresso do chamado">
    @for (int i = 0; i < etapas.Length; i++)
    {
        <li class="@(i <= atual ? "feito" : "") @(i == atual ? "atual" : "")">@etapas[i].Rotulo()</li>
    }
    </ol>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="cartao mb-3">
            <dl class="dados">
                <dt>Endereço</dt><dd>@Model.Endereco</dd>
                <dt>Descrição</dt><dd>@Model.Descricao</dd>
                @if (Model.DataProgramada is DateOnly d)
                {
                    <dt>Programado para</dt><dd>@d.ToString("dd/MM/yyyy")</dd>
                }
                @if (Model.Latitude is not null && Model.Longitude is not null)
                {
                    <dt>Coordenadas</dt><dd>@Model.Latitude, @Model.Longitude</dd>
                }
                @if (!string.IsNullOrEmpty(Model.MotivoRecusa))
                {
                    <dt>Motivo da recusa</dt><dd>@Model.MotivoRecusa</dd>
                }
            </dl>
        </div>
        @if (!string.IsNullOrEmpty(Model.FotoPath))
        {
            <div class="cartao"><img src="@Model.FotoPath" alt="Foto do problema" class="foto-chamado" /></div>
        }
    </div>
    <div class="col-lg-5">
        <div class="cartao">
            <h2 class="h6 mb-3">Histórico</h2>
            <ul class="linha-tempo">
            @foreach (var h in Model.Historico.OrderByDescending(h => h.Em))
            {
                <li>
                    <time>@h.Em.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time>
                    <strong>@h.Status.Rotulo()</strong> · @h.Observacao
                </li>
            }
            </ul>
        </div>
    </div>
</div>

<p class="mt-3"><a asp-action="Index" asp-route-busca="@Model.Solicitante">← Voltar aos meus chamados</a></p>
