@using ChamadosCampo.Web.Models
@{
    ViewData["Title"] = "Painel da chefia";
    var pendentes = (List<Chamado>)ViewBag.Pendentes;
    var aceitos = (List<Chamado>)ViewBag.Aceitos;
    var programados = (List<Chamado>)ViewBag.Programados;
    var emAndamento = (List<Chamado>)ViewBag.EmAndamento;
}

<h1>Painel da chefia</h1>

<h2 class="h5 mt-4">Aguardando análise (@pendentes.Count)</h2>
@foreach (var c in pendentes)
{
    <div class="card mb-2"><div class="card-body">
        <strong>@c.Tipo</strong> – @c.Endereco<br />@c.Descricao
        <div class="mt-2 d-flex gap-2">
            <form asp-action="Aceitar" method="post"><input type="hidden" name="id" value="@c.Id" /><button class="btn btn-success btn-sm">Aceitar (gera OS)</button></form>
            <form asp-action="Recusar" method="post" class="d-flex gap-1">
                <input type="hidden" name="id" value="@c.Id" />
                <input name="motivo" class="form-control form-control-sm" placeholder="Motivo da recusa" required />
                <button class="btn btn-outline-danger btn-sm">Recusar</button>
            </form>
        </div>
    </div></div>
}

<h2 class="h5 mt-4">OS aceitas, sem programação (@aceitos.Count)</h2>
@foreach (var c in aceitos)
{
    <div class="card mb-2"><div class="card-body">
        <strong>OS @c.NumeroOs</strong> – @c.Tipo – @c.Endereco
        <div class="mt-2 d-flex gap-2">
            <form asp-action="Programar" method="post" class="d-flex gap-1">
                <input type="hidden" name="id" value="@c.Id" />
                <input type="date" name="data" class="form-control form-control-sm" required />
                <button class="btn btn-primary btn-sm">Programar</button>
            </form>
            <form asp-action="Iniciar" method="post"><input type="hidden" name="id" value="@c.Id" /><button class="btn btn-outline-primary btn-sm">Iniciar</button></form>
        </div>
    </div></div>
}

<h2 class="h5 mt-4">Programadas (@programados.Count)</h2>
@foreach (var c in programados)
{
    <div class="card mb-2"><div class="card-body">
        <strong>OS @c.NumeroOs</strong> – @c.Endereco – @c.DataProgramada?.ToString("dd/MM/yyyy")
        <form asp-action="Iniciar" method="post" class="mt-2"><input type="hidden" name="id" value="@c.Id" /><button class="btn btn-outline-primary btn-sm">Iniciar</button></form>
    </div></div>
}

<h2 class="h5 mt-4">Em andamento (@emAndamento.Count)</h2>
@foreach (var c in emAndamento)
{
    <div class="card mb-2"><div class="card-body">
        <strong>OS @c.NumeroOs</strong> – @c.Endereco
        <form asp-action="Encerrar" method="post" class="mt-2"><input type="hidden" name="id" value="@c.Id" /><button class="btn btn-success btn-sm">Encerrar</button></form>
    </div></div>
}
