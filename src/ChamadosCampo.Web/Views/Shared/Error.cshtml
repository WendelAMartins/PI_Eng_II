@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<div class="cartao vazio">
    <h1>Algo deu errado</h1>
    <p>Não foi possível concluir a ação. Volte e tente novamente.</p>
    @if (Model.ShowRequestId)
    {
        <p class="dica">Código da requisição: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" asp-controller="Chamados" asp-action="Index">Voltar ao início</a>
</div>
